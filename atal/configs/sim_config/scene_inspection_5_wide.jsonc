// Five quadrotors for the crossing-corridor inspection scenario (Blocks environment).
// WIDE variant: launch pads 6 m apart along east (y = -12 .. 12, NED) at x = 0, so drones
// climbing off neighbouring pads stay outside the 5 m horizontal separation minimum. Each drone spawns 4 m up (z=-4) and settles onto the
// ground. Missions: missions/inspection_5_conflict.json. Names must match the mission's vehicle_ids.
{
  "id": "SceneInspection5Wide",
  "actors": [
    {
      "type": "robot",
      "name": "Drone1",
      "origin": {"xyz": "0.0 -12.0 -4.0", "rpy-deg": "0 0 0"},
      "robot-config": "robot_quadrotor_fastphysics.jsonc"
    },
    {
      "type": "robot",
      "name": "Drone2",
      "origin": {"xyz": "0.0 -6.0 -4.0", "rpy-deg": "0 0 0"},
      "robot-config": "robot_quadrotor_fastphysics.jsonc"
    },
    {
      "type": "robot",
      "name": "Drone3",
      "origin": {"xyz": "0.0 0.0 -4.0", "rpy-deg": "0 0 0"},
      "robot-config": "robot_quadrotor_fastphysics.jsonc"
    },
    {
      "type": "robot",
      "name": "Drone4",
      "origin": {"xyz": "0.0 6.0 -4.0", "rpy-deg": "0 0 0"},
      "robot-config": "robot_quadrotor_fastphysics.jsonc"
    },
    {
      "type": "robot",
      "name": "Drone5",
      "origin": {"xyz": "0.0 12.0 -4.0", "rpy-deg": "0 0 0"},
      "robot-config": "robot_quadrotor_fastphysics.jsonc"
    }
  ],
  "clock": {
    "type": "steppable",
    "step-ns": 3000000,
    "real-time-update-rate": 3000000,
    "pause-on-start": false
  },
  "home-geo-point": {
    "latitude": 47.641468,
    "longitude": -122.140165,
    "altitude": 122.0
  },
  "segmentation": {
    "initialize-ids": true,
    "ignore-existing": false,
    "use-owner-name": true
  },
  "scene-type": "UnrealNative"
}
