// Phase 3 swarm scene (run_sar_swarm.py with missions/sar/scenario_swarm_dev.yaml):
// three pads 3 m apart at the one-drone pad (x 0, y -3 / 0 / 3; the same spacing as
// scene_three_drones.jsonc, which flew in CityEnviron). The drones then fly to the mission's
// staging points. Spawns at (0, 30) and (0, 130) were blocked in CityEnviron (2026-11-05).
{
  "id": "SceneSarThreeDrones",
  "actors": [
    {
      "type": "robot",
      "name": "Drone1",
      "origin": {
        "xyz": "0.0 -3.0 -4.0",
        "rpy-deg": "0 0 0"
      },
      "robot-config": "robot_quadrotor_fastphysics.jsonc"
    },
    {
      "type": "robot",
      "name": "Drone2",
      "origin": {
        "xyz": "0.0 0.0 -4.0",
        "rpy-deg": "0 0 0"
      },
      "robot-config": "robot_quadrotor_fastphysics.jsonc"
    },
    {
      "type": "robot",
      "name": "Drone3",
      "origin": {
        "xyz": "0.0 3.0 -4.0",
        "rpy-deg": "0 0 0"
      },
      "robot-config": "robot_quadrotor_fastphysics.jsonc"
    }
  ],
  "clock": {
    "type": "steppable",
    "step-ns": 3000000,
    "real-time-update-rate": 3000000,
    "pause-on-start": false
  },
  "home-geo-point": {
    "latitude": 47.641468,
    "longitude": -122.140165,
    "altitude": 122.0
  },
  "segmentation": {
    "initialize-ids": true,
    "ignore-existing": false,
    "use-owner-name": true
  },
  "scene-type": "UnrealNative"
}
